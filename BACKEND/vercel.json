{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/auto-assign",
      "schedule": "30 17 * * *"
    },
    {
      "path": "/api/cron/payment-reminders",
      "schedule": "30 2 * * 1",
      "comment": "Monday 2:30 AM UTC (8:00 AM IST)"
    },
    {
      "path": "/api/cron/payment-reminders",
      "schedule": "30 5 * * 2",
      "comment": "Tuesday 5:30 AM UTC (11:00 AM IST)"
    },
    {
      "path": "/api/cron/payment-reminders",
      "schedule": "30 7 * * 3",
      "comment": "Wednesday 7:30 AM UTC (1:00 PM IST)"
    },
    {
      "path": "/api/cron/payment-reminders",
      "schedule": "30 10 * * 4",
      "comment": "Thursday 10:30 AM UTC (4:00 PM IST)"
    },
    {
      "path": "/api/cron/payment-reminders",
      "schedule": "30 12 * * 5",
      "comment": "Friday 12:30 PM UTC (6:00 PM IST)"
    },
    {
      "path": "/api/cron/payment-reminders",
      "schedule": "30 5 * * 6",
      "comment": "Saturday 5:30 AM UTC (11:00 AM IST)"
    },
    {
      "path": "/api/cron/payment-reminders",
      "schedule": "30 7 * * 0",
      "comment": "Sunday 7:30 AM UTC (1:00 PM IST)"
    }
  ]
}