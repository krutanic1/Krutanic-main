{
  "version": 2,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/process-warmup",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/check-replies",
      "schedule": "*/5 * * * *"
    }
  ]
}
