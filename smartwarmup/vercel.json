{
  "version": 2,
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/process-warmup",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/check-replies",
      "schedule": "*/5 * * * *"
    }
  ]
}
