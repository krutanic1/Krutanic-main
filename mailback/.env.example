PORT=5001
MONGO_URI=mongodb+srv://tarun:tarunn@krutanic.10kcydn.mongodb.net/test?retryWrites=true&w=majority&appName=krutanic
DEFAULT_SMTP_HOST=smtp.gmail.com
DEFAULT_SMTP_PORT=587
DEFAULT_SMTP_SECURE=false
GEMINI_API_KEY=your_gemini_api_key_here

# Mail Blaster OTP auth
MAILBLASTER_AUTH_SECRET=replace_with_a_strong_random_secret
MAILBLASTER_AUTH_TTL_MS=3600000
MAILBLASTER_OTP_EXPIRY_MS=600000
MAILBLASTER_ADMIN_COLLECTION=adminlogin

# OTP mail sender (preferred)
MAILBLASTER_OTP_SMTP_USER=your_smtp_user
MAILBLASTER_OTP_SMTP_PASS=your_smtp_app_password
MAILBLASTER_OTP_FROM=your_smtp_user

# Optional fallback used if MAILBLASTER_OTP_* is not set
SMTP_MAIL=your_smtp_user
SMTP_PASSWORD=your_smtp_app_password

# Optional fallback for auth secret if MAILBLASTER_AUTH_SECRET is not set
JWT_SECRET=replace_with_a_strong_random_secret
