# Job Aggregator Environment Variables

# Python Job Scraper API Key (must match between backend and Python service)
PYTHON_API_KEY=your-api-key-here

# MongoDB Connection
MONGODB_URI=your-mongodb-connection-string-here

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173,http://localhost:3000

# Node Environment
NODE_ENV=production

# Python Service URL
PYTHON_SERVICE_URL=http://python-job-scraper:8001
PYTHON_SERVICE_API_KEY=your-api-key-here
